# OpenClaw Secrets - Example File
# Copy this to secrets.env and fill in your actual API keys
# NEVER commit secrets.env to Git!

# Gateway Authentication
OPENCLAW_GATEWAY_TOKEN='your-gateway-token-here'

# MiniMax API (Global)
OPENCLAW_MINIMAX_API_KEY='your-minimax-api-key'

# MiniMax API (China)
OPENCLAW_MINIMAX_CN_API_KEY='your-minimax-cn-api-key'

# Ark/Volces API
OPENCLAW_ARK_API_KEY='your-ark-api-key'

# OpenAI-compatible API (gmncode.cn)
OPENCLAW_OPENAI_API_KEY='your-openai-api-key'

# Telegram Bot
OPENCLAW_TELEGRAM_BOT_TOKEN='your-telegram-bot-token'

# Feishu Integration
OPENCLAW_FEISHU_APP_SECRET='your-feishu-app-secret'

# Memory Search (can use 'ollama-local' for local setup)
OPENCLAW_MEMORYSEARCH_REMOTE_API_KEY='ollama-local'
